<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>eu.mondevis.rappel-quotidien</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.12/bin/python3</string>
        <string>/Users/macwdbsequoia/Desktop/dossier Freebuff/mondevis/automation/rappel.py</string>
    </array>

    <!-- Tous les jours à 05:30 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/tmp/mondevis-rappel.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mondevis-rappel.err</string>
</dict>
</plist>
